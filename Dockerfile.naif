FROM python:3.12-slim

WORKDIR /app

# Dans une image naïve, l'outillage reste dans l'image finale.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Mauvais pour le cache :
# chaque changement de code invalide aussi l'installation des dépendances.
COPY . .

RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000

CMD ["python", "app.py"]
